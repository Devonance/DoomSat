digraph G {
  graph [bgcolor="#0f1116", fontname="DejaVu Sans Mono", fontcolor="#d8dde6", labelloc=t, labeljust=l, nodesep=0.35, ranksep=0.25, pad=0.4,
         label="DOOMSAT . DECISION GRAPH . one narrow typed question per head, over words that code made from telemetry; every answer is consumed by a rule\lThree heads, all judgments with no exact rule behind them; everything else is code. Replaying 120 logged states on 22 Sep 2026: 2,263 median input tokens per call, 461 ms median, and jev's own ranking reproducible between identical passes on every state where the top two sat 0.10 rubric levels apart or more (0 of 51), against 30% flipping below that.\l"];
  node [shape=box, style="rounded,filled", fillcolor="#161a22", fontname="DejaVu Sans Mono", fontsize=11, fontcolor="#d8dde6", penwidth=1.4, margin="0.18,0.12"];
  edge [color="#4a5160", arrowhead=none, penwidth=1.0];
  { rank=same; h0 [shape=plaintext, fillcolor="#0f1116", fontcolor="#4a5160", label="STATE (what code turns into words)"]; h1 [shape=plaintext, fillcolor="#0f1116", fontcolor="#d9a441", label="JEV . TYPED QUESTION"]; h2 [shape=plaintext, fillcolor="#0f1116", fontcolor="#4f8fd6", label="WHEN ASKED"]; h3 [shape=plaintext, fillcolor="#0f1116", fontcolor="#3fae6a", label="RULE THAT CONSUMES THE ANSWER"] }
  h0 -> h1 -> h2 -> h3 [style=invis];
  r0c0 [label="1. sector (the navigator)\l\lthat one sector's words: space (blocked /\ltight / open / long), ground (never explored /\lnew / partly walked / walked before /\lunknown), door (none or a distance band), and\lwhether the exit, a key, the ground hint or a\lpickup lies there. Every bearing in the state\lis binned into the same eight labels\l", color="#4a5160"];
  r0c1 [label="Score on a shared four-level rubric:\ldead end / leads on but old / worth a\llook / the way on\l", color="#d9a441"];
  r0c2 [label="once per open direction,\levery tick (~0.5 s), in\lEXPLORE and APPROACH; a\lblocked direction and one\lwith missing telemetry are\lnot offered\l", color="#4f8fd6"];
  r0c3 [label="code ranks the scores, adds the goal's weight and\lsubtracts a level from a direction just held without\lgetting anywhere, then keeps the committed WORLD\lBEARING unless another sector beats it by\lsector_margin (capped below one rubric level, so a\lwhole level always wins); a top-two gap under\lunsure_gap (0.10, calibrated from replay) goes to the\lnamed frontier fallback\l", color="#3fae6a"];
  { rank=same; r0c0; r0c1; r0c2; r0c3 }
  r0c0 -> r0c1 -> r0c2 -> r0c3;
  h0 -> r0c0 [style=invis];
  r1c0 [label="2. danger\l\lthe nearest enemy in the sector vocabulary\lwith a distance band, how many are in view,\lhealth and ammunition bands, and which sides\lare open\l", color="#4a5160"];
  r1c1 [label="Score on four levels: no danger / a\lfight to win / under fire / get out\l", color="#d9a441"];
  r1c2 [label="whenever an enemy is in\lview, in any mode\l", color="#4f8fd6"];
  r1c3 [label="at or above danger_sidestep (1.5) code strafes into\lthe open side, preferring a long passage; at or above\ldanger_retreat (2.5) it backs off. Firing, the weapon\land the aim are not asked: they are exact rules over\lnumbers code already has\l", color="#3fae6a"];
  { rank=same; r1c0; r1c1; r1c2; r1c3 }
  r1c0 -> r1c1 -> r1c2 -> r1c3;
  r0c0 -> r1c0 [style=invis];
  r2c0 [label="3. goal\l\lhealth, armor, ammunition, the enemy, and\lwhere the exit, a key and each pickup were\lseen -- all in the same eight direction\llabels; the standing order rides on this\lquestion, not in the state\l", color="#4a5160"];
  r2c1 [label="Choice: Explore / Scout / Kill enemies /\lRestore health / Stock ammo / Add armor\l", color="#d9a441"];
  r2c2 [label="every goal_every ticks\l(10)\l", color="#4f8fd6"];
  r2c3 [label="SET_GOAL, and a real effect on the next decisions:\lgoal_bonus levels are added to the sector holding that\lgoal's pickup, and SCOUT weights never-explored ground\l", color="#3fae6a"];
  { rank=same; r2c0; r2c1; r2c2; r2c3 }
  r2c0 -> r2c1 -> r2c2 -> r2c3;
  r1c0 -> r2c0 [style=invis];
  r3c0 [label="Code: the mode machine\l\lstuck, what is at arm's length, whether an\lenemy is in view, whether the level is\lfinished\l", color="#4a5160"];
  r3c1 [label="not jev: an explicit state machine,\levery transition an exact rule\l", color="#d9a441"];
  r3c2 [label="every tick, before jev is\lasked\l", color="#4f8fd6"];
  r3c3 [label="EXPLORE / APPROACH ask jev; OPERATE (press Use, give\lup after door_tries), RECOVER (back out until 64 units\lmoved) and DONE are pure code, so those ticks make no\lmodel call at all\l", color="#3fae6a"];
  { rank=same; r3c0; r3c1; r3c2; r3c3 }
  r3c0 -> r3c1 -> r3c2 -> r3c3;
  r2c0 -> r3c0 [style=invis];
  r4c0 [label="Code: the reflex layer\l\lthe same state, plus the turn still in flight\l", color="#4a5160"];
  r4c1 [label="not jev: invariants that hold under\levery mode\l", color="#d9a441"];
  r4c2 [label="on every command, last\l", color="#4f8fd6"];
  r4c3 [label="never fire at zero ammo; never walk into a known wall\l(unless it is a door to walk up to); never re-command\la turn still swinging; clamp the turn to max_turn_deg\l", color="#3fae6a"];
  { rank=same; r4c0; r4c1; r4c2; r4c3 }
  r4c0 -> r4c1 -> r4c2 -> r4c3;
  r3c0 -> r4c0 [style=invis];
  r5c0 [label="System Two: bump (Claude Sonnet 5)\l\lseconds into the attempt, cells gained,\lposition, most visited spots, the map product\las text\l", color="#8f6fe0"];
  r5c1 [label="not jev: a JSON-schema reply with\lbearing, hold time and an optional goal\l", color="#8f6fe0"];
  r5c2 [label="every 60 s\l", color="#4f8fd6"];
  r5c3 [label="EXPLORE_HINT(bearing, ttl): the payload steers 'ahead'\ltoward the bearing while it lasts, and the sector it\lfalls in reads hint_here yes; jev still scores every\lopen direction\l", color="#3fae6a"];
  { rank=same; r5c0; r5c1; r5c2; r5c3 }
  r5c0 -> r5c1 -> r5c2 -> r5c3;
  r4c0 -> r5c0 [style=invis];
  r6c0 [label="System Two: after-action (Claude Sonnet 5)\l\lthe episode report, built from the heads the\lepisode actually asked: outcome, health,\ldamage, cells, distance, spin windows, the\lscore distribution per head, what the\lselection did (held, fallbacks, gaps), the\lmodes, the last eight decisions, plus the\lcurrent graph and the bounds code enforces\l", color="#8f6fe0"];
  r6c1 [label="not jev: a revised graph (question\lwording, rubric levels, thresholds,\lselection numbers) with a rationale\l", color="#8f6fe0"];
  r6c2 [label="after every episode:\ldeath, level done, or the\l180 s budget\l", color="#4f8fd6"];
  r6c3 [label="code validates and REJECTS anything out of bounds --\loverlong text, a number out of range, an unknown head\lor option, a criterion naming a state field that does\lnot exist -- and hands the reason back for one more\ltry, then stores graph_v<N>.json\l", color="#3fae6a"];
  { rank=same; r6c0; r6c1; r6c2; r6c3 }
  r6c0 -> r6c1 -> r6c2 -> r6c3;
  r5c0 -> r6c0 [style=invis];
}