digraph G {
  graph [bgcolor="#0f1116", fontname="DejaVu Sans Mono", fontcolor="#d8dde6", labelloc=t, labeljust=l, nodesep=0.35, ranksep=0.25, pad=0.4,
         label="DOOMSAT . DECISION GRAPH . one narrow typed question per head, over words that code made from telemetry; every answer is consumed by a rule\lFour heads, all judgements with no exact rule behind them; everything else is code. One call carries them all: on the decision that found the exit on 24 Sep 2026 -- jev-1.13.0, 354 ms, 5,232 input tokens -- eight target scores, the engage choice and the weapon choice came back together, and the decision age from observation to command was 481 ms against a 900 ms budget.\l"];
  node [shape=box, style="rounded,filled", fillcolor="#161a22", fontname="DejaVu Sans Mono", fontsize=11, fontcolor="#d8dde6", penwidth=1.4, margin="0.18,0.12"];
  edge [color="#4a5160", arrowhead=none, penwidth=1.0];
  { rank=same; h0 [shape=plaintext, fillcolor="#0f1116", fontcolor="#4a5160", label="STATE (what code turns into words)"]; h1 [shape=plaintext, fillcolor="#0f1116", fontcolor="#d9a441", label="JEV . TYPED QUESTION"]; h2 [shape=plaintext, fillcolor="#0f1116", fontcolor="#4f8fd6", label="WHEN ASKED"]; h3 [shape=plaintext, fillcolor="#0f1116", fontcolor="#3fae6a", label="RULE THAT CONSUMES THE ANSWER"] }
  h0 -> h1 -> h2 -> h3 [style=invis];
  r0c0 [label="1. target (the navigator)\l\lone candidate place to go, in words: what it\lis (unexplored edge / a door / the level exit\l/ a key / a pickup), how far along the floor,\lhow far COMPARED WITH the other candidates,\lits direction, how much unseen ground lies\lbehind it, how far that runs, how wide the way\lon is, what is standing near it, whether it\lhas been tried, whether it leads away from\lwhere the level began, and what gate is in the\lway (none / a door / a locked door and whether\lits key is held). No coordinates and no\lnumbers reach jev: the world position rides in\lthe INTENT, where code uses it to aim\l", color="#4a5160"];
  r0c1 [label="Score on a nine-level rubric, worst\lfirst: not reachable / a bad trade /\lnothing behind it / worth it nearer / a\lfair next step / worth a detour / the\lobvious move / the way on / the way out\l", color="#d9a441"];
  r0c2 [label="once per candidate, up to\leight, on every decision\l(about twice a second)\lwhenever more than one\lplace is on offer. One\lcandidate is not a choice\land is not asked\l", color="#4f8fd6"];
  r0c3 [label="code ranks the scores, then holds what it is already\lwalking to unless another beats it by a margin -- a\lfrontier RECEDES as you explore, so commitment matches\la neighbourhood and not an exact cell. Below\lunsure_gap (0.05 rubric levels) or below unsure_conf\lthe answer is not used, and the ONE fallback the brief\lallows applies: keep the current target, else take the\lnearest way on\l", color="#3fae6a"];
  { rank=same; r0c0; r0c1; r0c2; r0c3 }
  r0c0 -> r0c1 -> r0c2 -> r0c3;
  h0 -> r0c0 [style=invis];
  r1c0 [label="2. need\l\lhealth, armor and ammunition against the\lthresholds in knowledge/doom_rules.yaml, as\lurgency words\l", color="#4a5160"];
  r1c1 [label="Score each of health / armor / ammo:\lurgent / wanted / nice to have / none\l", color="#d9a441"];
  r1c2 [label="every goal_every decisions\l", color="#4f8fd6"];
  r1c3 [label="code re-weights which pickups are offered as\lcandidates at all: a detour is only worth making for\lsomething the player actually needs now\l", color="#3fae6a"];
  { rank=same; r1c0; r1c1; r1c2; r1c3 }
  r1c0 -> r1c1 -> r1c2 -> r1c3;
  r0c0 -> r1c0 [style=invis];
  r2c0 [label="3. engage\l\lwhat is in view and how dangerous the\lknowledge file says that class is, how many,\lhow far, against health, armor and what is\lloaded -- and what else there is to be doing\l", color="#4a5160"];
  r2c1 [label="Choice: Fight where I stand / Fight\lwhile moving / Break off and go round /\lRetreat\l", color="#d9a441"];
  r2c2 [label="whenever something is in\lview, in any mode\l", color="#4f8fd6"];
  r2c3 [label="code sets the INTENT's mode and stance from it. The\lbackstop when it is not asked is deliberately NEUTRAL\l(break off and keep moving): a baseline that picks\lfights is the most dangerous player in its own\lcomparison, and a row built on one measures the code's\lrecklessness, not the model's judgement\l", color="#3fae6a"];
  { rank=same; r2c0; r2c1; r2c2; r2c3 }
  r2c0 -> r2c1 -> r2c2 -> r2c3;
  r1c0 -> r2c0 [style=invis];
  r3c0 [label="4. weapon\l\lthe enemy class, distance and count against\lthe weapons owned that have ammunition\l", color="#4a5160"];
  r3c1 [label="Choice among the owned weapons: Fist /\lPistol / Shotgun / Chaingun /\lRocketLauncher\l", color="#d9a441"];
  r3c2 [label="with the engage head\l", color="#4f8fd6"];
  r3c3 [label="the slot rides in the INTENT and the executor selects\lit. A rule backstop overrides one case the model\lshould not be trusted with: never a rocket at point\lblank\l", color="#3fae6a"];
  { rank=same; r3c0; r3c1; r3c2; r3c3 }
  r3c0 -> r3c1 -> r3c2 -> r3c3;
  r2c0 -> r3c0 [style=invis];
  r4c0 [label="Code: the payload's world model (onboard, 35 Hz)\l\lexact level geometry from the engine, GATED: a\lline reaches the pilot only once the automap\lhas drawn half the points sampled along it.\lSightlines against those lines say which floor\lhas been seen; floor heights say which rises\lcan be climbed, which are ledges, and which\lsectors are shut doors rather than solid\lpillars\l", color="#4a5160"];
  r4c1 [label="not jev: measurement and bookkeeping\l", color="#d9a441"];
  r4c2 [label="every tic; the candidate\llist is rebuilt a few\ltimes a second\l", color="#4f8fd6"];
  r4c3 [label="frontiers (the edge of the seen), doors, the exit if\lone has been looked at, and pickups, each with its\lpath distance -- pruned to the eight the ground\lscores. A live guardrail fails any run holding a line\lthe automap cannot account for\l", color="#3fae6a"];
  { rank=same; r4c0; r4c1; r4c2; r4c3 }
  r4c0 -> r4c1 -> r4c2 -> r4c3;
  r3c0 -> r4c0 [style=invis];
  r5c0 [label="Code: the onboard executor (charter 3.1)\l\lthe payload's own fast sensing every tic:\lposition, heading, what the range camera\lreports ahead and on each shoulder, what is at\larm's length, what is in view\l", color="#4a5160"];
  r5c1 [label="not jev: it carries out the INTENT it\lwas last given, and drops to safe\lbehaviour when the time to live runs out\l", color="#d9a441"];
  r5c2 [label="every tic, 35 Hz, between\ldecisions\l", color="#4f8fd6"];
  r5c3 [label="follows the planned path, re-acquiring it when the\lplayer has come off; throttles by how much room there\lis to turn in rather than by a fixed angle; sidesteps\lwhat the camera sees; aims and fires; pulses Use at a\ldoor; takes a panorama on new ground. The ground never\lsends buttons\l", color="#3fae6a"];
  { rank=same; r5c0; r5c1; r5c2; r5c3 }
  r5c0 -> r5c1 -> r5c2 -> r5c3;
  r4c0 -> r5c0 [style=invis];
  r6c0 [label="Code: the watchdog\l\lwhere the player has been over the last four\lseconds\l", color="#4a5160"];
  r6c1 [label="not jev: invariants checked at control\lrate\l", color="#d9a441"];
  r6c2 [label="every tic\l", color="#4f8fd6"];
  r6c3 [label="trips when the player covers no ground, and ALSO when\lit covers plenty and gets nowhere -- a wedged player\lflails, and flailing is motion, so a test that only\lmeasures distance reads it as healthy. The recovery\lretreats to a cell the player has already stood in,\lwhich is walkable by demonstration rather than by\linference\l", color="#3fae6a"];
  { rank=same; r6c0; r6c1; r6c2; r6c3 }
  r6c0 -> r6c1 -> r6c2 -> r6c3;
  r5c0 -> r6c0 [style=invis];
  r7c0 [label="System Two (Claude Sonnet 5)\l\lthe episode report and the current graph\l", color="#8f6fe0"];
  r7c1 [label="not jev: a revised graph with a\lrationale, which code validates and may\lreject\l", color="#8f6fe0"];
  r7c2 [label="after an episode, when it\lis enabled\l", color="#4f8fd6"];
  r7c3 [label="it was OFF for the run that finished E1M1 and for\levery measurement beside it, so nothing here is owed\lto it\l", color="#3fae6a"];
  { rank=same; r7c0; r7c1; r7c2; r7c3 }
  r7c0 -> r7c1 -> r7c2 -> r7c3;
  r6c0 -> r7c0 [style=invis];
}