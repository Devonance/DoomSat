// Data flow: every message, its type and rate, from the game to the models and back. Render: dot -Tpng -Gdpi=150 dataflow.dot -o dataflow.png
digraph dataflow {
  rankdir=TB;
  graph [fontname="Helvetica", fontsize=12, pad=0.3, nodesep=0.3, ranksep=0.45, bgcolor="white"];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", color="#444444", penwidth=1.1];
  edge  [fontname="Helvetica", fontsize=8.5, color="#555555", arrowsize=0.7];

  game   [label="Doom engine (ViZDoom)", fillcolor="#fde9d9"];
  sense  [label="Player-side sensing\nscreen 640x480 RGB | depth buffer | labels (visible things) | automap (seen lines only) | HUD variables", fillcolor="#fde9d9"];
  nav    [label="Onboard navigator (code)\nworld raster 4 u/px, 32-unit cells, Dijkstra, targets: exit > key > goal item > frontier > walls", fillcolor="#fde9d9"];
  status [label="STATUS record, 76 bytes, big-endian struct\nhealth, armor, ammo, position, heading, enemy bearing/distance,\nclearances, route bearing/distance, target kind, stuck, use-ahead,\nlevel, keys, navigator mode, doors known ... @ 12 Hz", fillcolor="#fff7e6"];
  frame  [label="FRAME: JPEG 320x240 q45, ~8 KB @ 10 fps", fillcolor="#fff7e6"];
  comp   [label="F´ Doom component\nTCP client to the payload; parses STATUS -> 44 telemetry channels (tlmWrite),\nsplits JPEG into FrameChunk records (960 B) -> Fw::Com buffers", fillcolor="#dbe8f7"];
  ctrlc  [label="F´ commands (opcodes 0-4)\nCONTROL(move I8, strafe I8, turn F32 deg, fire, use, weapon)\nSET_GOAL(Goal)  RESET_GAME  FRAME_RATE(hz, quality)  EXPLORE_HINT(bearing, ttl)", fillcolor="#dbe8f7"];
  tm     [label="CCSDS Space Packets (APID 1 telemetry, 2 events, 3 file)\nin fixed 1024 B TM frames, UDP to the ground", fillcolor="#dbe8f7"];
  tc     [label="CCSDS TC: Space Packets APID 0 (commands)", fillcolor="#dbe8f7"];
  mdb    [label="Yamcs mission database (XTCE)\ngenerated by fprime-xtce from the F´ JSON dictionary:\n148 parameters, 54 commands, FrameChunk as a binary parameter", fillcolor="#e2efd9"];
  yamcs  [label="Yamcs: TM decoding, archive (RocksDB), realtime processor,\nparameter WebSocket, command HTTP API, bucket 'doomframes'", fillcolor="#e2efd9"];
  ground [label="Ground parameters (local XTCE /DoomGround)\nDoomFrame URL, FrameSeq, SystemOneLatencyMs, Controls, Plan ...", fillcolor="#e2efd9"];
  openmct[label="Open MCT: plots of telemetry, DoomFrame image (yamcs.image)", fillcolor="#e2efd9"];
  words  [label="decision_graph.py: numbers -> words\nthreat, space ahead/left/right, aim offset, health, ammo, navigator mode ...", fillcolor="#fff2cc"];
  jev    [label="jev (TypeSafe System One)\nPOST /v1/systemone: state JSON + Choice questions\n-> choice per head + confidence, ~0.4 s", fillcolor="#ead1ea"];
  cmd    [label="control_args(): choices -> CONTROL arguments\n(turn degrees from the graph's turn table)", fillcolor="#fff2cc"];
  log    [label="out/decisions.jsonl: one row per decision\n(answers, confidence, request id, latency, telemetry snapshot)", fillcolor="#fff2cc"];
  aar    [label="after_action.py: episode report (~2 KB JSON)\noutcome, level, health, damage, stuck/flip patterns, per-head answer stats, last moments", fillcolor="#fff2cc"];
  sonnet [label="Claude Sonnet 5 (System Two)\nclaude -p --json-schema: report + current graph -> revised graph config\n(wording, criteria, thresholds, turn sizes, standing order) + rationale", fillcolor="#ead1ea"];
  graphcfg [label="ground/graph/graph_v<N>.json + CHANGELOG.md\nvalidated by code, hot-swapped for the next episode", fillcolor="#fff2cc"];

  game -> sense [label="every tic (35 Hz)"];
  sense -> nav;
  nav -> status; sense -> frame;
  status -> comp [label="TCP 127.0.0.1:4242"]; frame -> comp [label="TCP"];
  comp -> tm [label="telemetry + FrameChunk records"];
  tm -> yamcs [label="UDP 50000"]; mdb -> yamcs [style=dashed, label="decodes with"];
  yamcs -> openmct [label="WebSocket"];
  yamcs -> words [label="parameter subscription (WebSocket)\n44 values @ 12 Hz"];
  yamcs -> ground [dir=both, label="set/get"]; ground -> openmct;
  words -> jev [label="HTTPS"]; jev -> cmd; cmd -> yamcs [label="issue_command (HTTP)"];
  yamcs -> tc [label="TC frames"]; tc -> ctrlc [label="UDP 50001"]; ctrlc -> comp; comp -> nav [label="CONTROL / goal / hint\n(TCP)"];
  jev -> log; log -> aar [label="at episode end"]; aar -> sonnet; sonnet -> graphcfg; graphcfg -> words [label="next episode"];
  yamcs -> frame_bucket [label="upload JPEG (pilot)"];
  frame_bucket [label="Yamcs bucket 'doomframes' (image products)", fillcolor="#e2efd9"];
  frame_bucket -> openmct;
}
